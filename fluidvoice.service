[Unit]
Description=FluidVoice Lite — lokales Diktat (Parakeet TDT v3)
Documentation=https://github.com/altic-dev/FluidVoice
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=/home/ingorossdeutscher/Projects/fluidvoice-lite
ExecStart=/home/ingorossdeutscher/Projects/fluidvoice-lite/.venv/bin/python -u fvld.py
Environment=WAYLAND_DISPLAY=wayland-0
# Optional: Einfüge-Kürzel je nach App (ctrl+v oder ctrl+shift+v)
# Environment=FVL_PASTE_KEY=ctrl+v
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
